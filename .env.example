# ============================================================
#  .env.example — Plantilla de variables de entorno
#  Copia este archivo a .env y rellena con tus claves reales
#  NUNCA subas el archivo .env a GitHub
# ============================================================

# ── IA / LLMs ───────────────────────────────────────────────
GEMINI_API_KEY=tu_clave_gemini_aqui
OPENAI_API_KEY=tu_clave_openai_aqui
ANTHROPIC_API_KEY=tu_clave_anthropic_aqui
XAI_API_KEY=tu_clave_xai_grok_aqui
GROK_API_KEY=tu_clave_grok_aqui
MISTRAL_API_KEY=tu_clave_mistral_aqui

# ── Búsqueda y servicios web ────────────────────────────────
SERPAPI_API_KEY=tu_clave_serpapi_aqui
YOUTUBE_API_KEY=tu_clave_youtube_aqui

# ── Home Assistant ──────────────────────────────────────────
HA_URL=http://tu_ip_local:8123
HA_TOKEN=tu_token_largo_de_home_assistant

# ── Telegram (opcional) ─────────────────────────────────────
TELEGRAM_BOT_TOKEN=tu_token_de_telegram_aqui
TELEGRAM_CHAT_ID=tu_chat_id_aqui

# ── OpenRouter (opcional) ───────────────────────────────────
OPENROUTER_API_KEY=tu_clave_openrouter_aqui

# ── Rutas personalizadas (opcional) ─────────────────────────
CHROME_PATH=
ANTIGRAVITY_PATH=
JARVIS_OLLAMA_BASE_URL=http://localhost:11434/v1
JARVIS_OLLAMA_MODEL=ornith:9b
